# Esim menu
esim.enable_esim_system_ui_by_default=true
masterclear.allow_retain_esim_profiles_after_fdr=true

# Google
ro.opa.device_model_id=motorola-rtwo
ro.opa.eligible_device=true

# Marketing name, shown in Settings -> About phone (overridden per SKU below)
ro.product.marketname=motorola edge 40 pro

# Radio
ro.vendor.radio.imei.sv=25

# SKU specific properties
import /product/etc/hardware.sku.${ro.boot.hardware.sku}.prop
